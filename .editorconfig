# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kts,gradle.kts}]
indent_size = 2

[*.{yml,yaml,json,xml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[{gradlew,*.sh}]
indent_size = 2

[gradlew.bat]
end_of_line = crlf
